# Values for createLLM({ apiKey, model, baseURL }). Nothing reads them yet:
# the entry point that passes them in (index.ts) is not written. Set them in
# your process environment.
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=your-model-id

# Optional OpenAI-compatible endpoint override.
# OPENAI_BASE_URL=https://your-provider.example/v1

# This project does not automatically load .env files.
